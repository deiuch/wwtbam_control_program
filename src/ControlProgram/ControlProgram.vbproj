<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>WWTBAM Control Program</AssemblyName>
    <RootNamespace>ControlProgram</RootNamespace>
    <StartupObject>ControlProgram.My.MyApplication</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Update="*Form.vb" SubType="Form" />
    <Compile Update="MyProject\Application.Designer.vb" AutoGen="True" DependentUpon="Application.myapp" DesignTime="True" />
    <Compile Update="MyProject\Resources.Designer.vb" AutoGen="True" DependentUpon="Resources.resx" DesignTime="True" />
    <EmbeddedResource Update="MyProject\Resources.resx" Generator="VbMyResourcesResXFileCodeGenerator" LastGenOutput="Resources.Designer.vb" CustomToolNamespace="My.Resources" />
    <None Update="MyProject\Application.myapp" Generator="MyApplicationCodeGenerator" LastGenOutput="Application.Designer.vb" />
  </ItemGroup>
  <Import Project="..\Package.targets" />
</Project>
